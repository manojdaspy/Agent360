{
  "manifest_version": 3,
  "name": "Agent360",
  "version": "14.1.0",
  "description": "AI DOM bridge + MCP agent",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://chat.openai.com/*",
      "https://chat.deepseek.com/*",
      "https://gemini.google.com/*",
      "https://aistudio.google.com/*",
      "https://grok.com/*",
      "https://x.com/*",
      "https://copilot.microsoft.com/*",
      "https://www.bing.com/*",
      "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
          "https://chatgpt.com/*",
          "https://claude.ai/*",
          "https://chat.openai.com/*",
          "https://chat.deepseek.com/*",
          "https://gemini.google.com/*",
          "https://aistudio.google.com/*",
          "https://grok.com/*",
          "https://copilot.microsoft.com/*",
          "https://www.bing.com/*",
          "http://localhost:8000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src *; trusted-types luckeyvibespolicy 'allow-duplicates'"
  }
}